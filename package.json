{
  "name": "task-bridge",
  "version": "0.11.1",
  "private": true,
  "description": "Obsidian plugin for syncing tasks between Obsidian notes and a cloud task management platform",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit && node esbuild.config.mjs production",
    "test": "jest",
    "test:all": "jest --projects jest.config.js jest.integration.config.js",
    "test:unit": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --config jest.integration.config.js",
    "commitlint": "commitlint",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "prepare": "husky"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "task-sync",
    "todoist"
  ],
  "author": "Jan Pralle",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.5",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.11",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "obsidian": "latest",
    "ts-jest": "^29.1.1",
    "typescript": "5.3.3"
  }
}

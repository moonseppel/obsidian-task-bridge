    "@types/node": "^20.10.5",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.11",
    "jest": "^29.7.0",
    "obsidian": "latest",
    "ts-jest": "^29.1.1",
    "typescript": "5.3.3"
  }
